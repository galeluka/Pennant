[{"id":"m_document","name":"Change proposal — document model","domain":"Document review","question":"Is this proposal saying something that can be checked, and in what order do we check it?","summary":"A change proposal modelled as a graph rather than read as prose. Sections make claims; claims create obligations; evidence settles claims. An analyzer is pointed at one claim, not at the document, which is the difference between a finding and an impression. Deliberately shipped with one unevidenced claim — c_benefit, the load-bearing one — because that is the finding the template exists to teach. Contains no real proposal: every label is generic and there is nothing here from any organisation.","anonymised":true,"layers":[{"id":"l1","name":"The document","role":"..."},{"id":"l2","name":"What it commits","role":"..."},{"id":"l3","name":"What settles it","role":"..."}],"nodes":[{"id":"doc","layer":"l1","kind":"document","label":"Change proposal","props":{},"note":""},{"id":"s_summary","layer":"l1","kind":"chapter","label":"Summary","props":{},"note":""},{"id":"s_scope","layer":"l1","kind":"chapter","label":"Scope","props":{},"note":""},{"id":"s_plan","layer":"l1","kind":"chapter","label":"Delivery plan","props":{},"note":""},{"id":"s_risk","layer":"l1","kind":"chapter","label":"Risk and rollback","props":{},"note":""},{"id":"s_cost","layer":"l1","kind":"chapter","label":"Cost","props":{},"note":""},{"id":"c_benefit","layer":"l2","kind":"claim","label":"The benefit is worth the cost","props":{},"note":""},{"id":"c_dates","layer":"l2","kind":"claim","label":"The dates are achievable","props":{},"note":""},{"id":"c_rollback","layer":"l2","kind":"claim","label":"It can be rolled back","props":{},"note":""},{"id":"c_nodep","layer":"l2","kind":"claim","label":"No other team is blocked","props":{},"note":""},{"id":"o_owner","layer":"l2","kind":"obligation","label":"Named owner accepts the date","props":{},"note":""},{"id":"o_runbook","layer":"l2","kind":"obligation","label":"R