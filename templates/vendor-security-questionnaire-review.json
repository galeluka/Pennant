{
  "kind": "doccritique.knowledge-model",
  "schemaVersion": "1.1",
  "model": {
    "schemaVersion": 2,
    "id": "m_vendor_questionnaire",
    "name": "Vendor security questionnaire — review template",
    "domain": "third party security assurance",
    "domainId": "third-party-security-assurance",
    "reviewDomain": "document-review",
    "question": "Which of this vendor's answers are evidenced by somebody other than the vendor?",
    "summary": "A completed third-party security questionnaire modelled as a document graph. Its point is the distinction prose flattens: one claim is evidenced by an independent audit report, another only by the vendor's own completed questionnaire, and a third by nothing at all. All three read identically in the response document; only the graph separates them. One chapter is left unchecked so the gap audit reports it passing by default. No real vendor, product, certificate or audit reference appears here.",
    "anonymised": true,
    "createdAt": "2026-07-25T00:00:00.000Z",
    "layers": [
      {
        "id": "l1",
        "name": "The response as submitted",
        "role": "The document and its chapters. No claims belong here."
      },
      {
        "id": "l2",
        "name": "What the vendor asserts and owes",
        "role": "Claims that could be false, obligations they create, and the analyzers responsible for them. No evidence belongs here."
      },
      {
        "id": "l3",
        "name": "What would settle it",
        "role": "Independent reports and signed instruments. The vendor's own word is recorded here too, marked as what it is."
      }
    ],
    "nodes": [
      {
        "id": "doc",
        "layer": "l1",
        "kind": "document",
        "label": "Third-party security questionnaire response",
        "props": {},
        "note": ""
      },
      {
        "id": "ch_access",
        "layer": "l1",
        "kind": "chapter",
        "label": "Access control",
        "props": {},
        "note": ""
      },
      {
        "id": "ch_encrypt",
        "layer": "l1",
        "kind": "chapter",
        "label": "Encryption",
        "props": {},
        "note": "No analyzer is pointed here, so it passes by default. Deliberate."
      },
      {
        "id": "ch_subproc",
        "layer": "l1",
        "kind": "chapter",
        "label": "Sub-processors",
        "props": {},
        "note": ""
      },
      {
        "id": "ch_ir",
        "layer": "l1",
        "kind": "chapter",
        "label": "Incident response",
        "props": {},
        "note": ""
      },
      {
        "id": "c_mfa",
        "layer": "l2",
        "kind": "claim",
        "label": "Administrative access requires multi-factor authentication",
        "props": {},
        "note": ""
      },
      {
        "id": "c_rest",
        "layer": "l2",
        "kind": "claim",
        "label": "Customer data is encrypted at rest",
        "props": {},
        "note": "Evidenced only by the vendor's own questionnaire. That is an assertion repeated, not evidence."
      },
      {
        "id": "c_notify",
        "layer": "l2",
        "kind": "claim",
        "label": "A breach is notified within twenty-four hours",
        "props": {},
        "note": "Deliberately unevidenced. Nothing here would settle it."
      },
      {
        "id": "c_nosub",
        "layer": "l2",
        "kind": "claim",
        "label": "No sub-processor handles customer data",
        "props": {},
        "note": ""
      },
      {
        "id": "o_pentest",
        "layer": "l2",
        "kind": "obligation",
        "label": "Provide an annual penetration test report",
        "props": {},
        "note": ""
      },
      {
        "id": "o_subnotice",
        "layer": "l2",
        "kind": "obligation",
        "label": "Notify before adding a sub-processor",
        "props": {},
        "note": ""
      },
      {
        "id": "act_assurance",
        "layer": "l2",
        "kind": "actor",
        "label": "Security assurance lead",
        "props": {},
        "note": ""
      },
      {
        "id": "a_unev",
        "layer": "l2",
        "kind": "analyzer",
        "label": "Claim with no evidence at all",
        "props": {},
        "note": "An answer nothing would settle.",
        "appliesTo": {
          "domains": [
            "document-review"
          ],
          "targetKinds": [
            "claim"
          ],
          "requires": []
        },
        "consumes": [
          "claim list"
        ],
        "produces": [
          "unevidenced claims"
        ]
      },
      {
        "id": "a_self",
        "layer": "l2",
        "kind": "analyzer",
        "label": "Claim evidenced only by the vendor",
        "props": {},
        "note": "An answer whose only support is the document making it.",
        "appliesTo": {
          "domains": [
            "document-review"
          ],
          "targetKinds": [
            "claim"
          ],
          "requires": []
        },
        "consumes": [
          "claim list",
          "evidence list"
        ],
        "produces": [
          "self-attested claims"
        ]
      },
      {
        "id": "a_placeholder",
        "layer": "l2",
        "kind": "analyzer",
        "label": "Chapter promised and never written",
        "props": {},
        "note": "A section the response commits to and does not contain.",
        "appliesTo": {
          "domains": [
            "document-review"
          ],
          "targetKinds": [
            "document",
            "chapter"
          ],
          "requires": []
        },
        "consumes": [
          "chapter list"
        ],
        "produces": [
          "missing content"
        ]
      },
      {
        "id": "ev_audit",
        "layer": "l3",
        "kind": "evidence",
        "label": "Independent third-party audit report",
        "props": {},
        "note": ""
      },
      {
        "id": "ev_self",
        "layer": "l3",
        "kind": "evidence",
        "label": "The vendor's own completed questionnaire",
        "props": {},
        "note": "Recorded as evidence so the graph can show that it is the only thing behind a claim."
      },
      {
        "id": "ev_dpa",
        "layer": "l3",
        "kind": "evidence",
        "label": "Signed processing agreement, sub-processor annex",
        "props": {},
        "note": ""
      }
    ],
