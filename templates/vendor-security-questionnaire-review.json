    "logic": {
      "goal": "Separate the answers an independent party would confirm from the ones only the vendor asserts.",
      "steps": [
        {
          "id": "st_ext",
          "name": "Extract chapters, claims and evidence",
          "kind": "extract",
          "intent": "Lift the structure of the response before judging any answer.",
          "prompt": "",
          "consumes": [],
          "produces": [
            "chapter list",
            "claim list",
            "evidence list"
          ]
        },
        {
          "id": "st_ph",
          "name": "Missing content check",
          "kind": "analyzer",
          "intent": "Sections promised and not written.",
          "prompt": "",
          "consumes": [
            "chapter list"
          ],
          "produces": [
            "missing content"
          ],
          "srcNode": "a_placeholder"
        },
        {
          "id": "st_unev",
          "name": "No evidence check",
          "kind": "analyzer",
          "intent": "Answers with nothing behind them.",
          "prompt": "",
          "consumes": [
            "claim list"
          ],
          "produces": [
            "unevidenced claims"
          ],
          "srcNode": "a_unev"
        },
        {
          "id": "st_self",
          "name": "Self-attestation check",
          "kind": "analyzer",
          "intent": "Answers supported only by the document making them.",
          "prompt": "",
          "consumes": [
            "claim list",
            "evidence list"
          ],
          "produces": [
            "self-attested claims"
          ],
          "srcNode": "a_self"
        },
        {
          "id": "st_gate",
          "name": "Proportion gate",
          "kind": "proportions",
          "intent": "Is the assurance effort this vendor needs inside what the team can absorb?",
          "prompt": "",
          "consumes": [
            "missing content",
            "unevidenced claims",
            "self-attested claims"
          ],
          "produces": [
            "assurance verdict"
          ]
        },
        {
          "id": "st_call",
          "name": "Assurance decision",
          "kind": "human",
          "intent": "A named person accepts the vendor, accepts with conditions, or refuses.",
          "prompt": "",
          "consumes": [
            "assurance verdict"
          ],
          "produces": []
        }
      ],
