        "note": ""
      },
      {
        "id": "e_0015",
        "from": "ds_lake",
        "rel": "OWNED_BY",
        "to": "act_data",
        "note": ""
      }
    ],
    "logic": {
      "goal": "List every component that runs, and name the ones with nobody accountable for them.",
      "steps": [
        {
          "id": "st_map",
          "name": "Map what runs",
          "kind": "extract",
          "intent": "Enumerate the deployed components and the ownership actually declared.",
          "prompt": "",
          "consumes": [],
          "produces": [
            "running components",
            "declared owners"
          ]
        },
        {
          "id": "st_gap",
          "name": "Match components to owners",
          "kind": "transform",
          "intent": "Set difference, not judgement. No analyzer applies to a system model.",
          "prompt": "",
          "consumes": [
            "running components",
            "declared owners"
          ],
          "produces": [
            "components with no owner"
          ]
        },
        {
          "id": "st_gate",
          "name": "Proportion gate",
          "kind": "proportions",
          "intent": "Can the team named actually carry the components attributed to it?",
          "prompt": "",
          "consumes": [
            "components with no owner"
          ],
          "produces": [
            "operability verdict"
          ]
        },
        {
          "id": "st_call",
          "name": "Platform review",
          "kind": "human",
          "intent": "A named person assigns the orphans or accepts the risk.",
          "prompt": "",
          "consumes": [
            "operability verdict"
          ],
          "produces": []
        }
      ],
      "edges": [
        {
          "id": "le_0001",
          "from": "st_map",
          "to": "st_gap",
          "rel": "needs"
        },
        {
          "id": "le_0002",
          "from": "st_gap",
          "to": "st_gate",
          "rel": "needs"
        },
        {
          "id": "le_0003",
          "from": "st_gate",
          "to": "st_call",
          "rel": "needs"
        }
      ]
    }
  }
