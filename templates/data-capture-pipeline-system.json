  "model": {
    "schemaVersion": 2,
    "id": "m_capture_pipeline",
    "name": "Change data capture pipeline — system model",
    "domain": "data distribution platform",
    "domainId": "data-distribution-platform",
    "reviewDomain": "system",
    "question": "What runs in this pipeline, what does it write to, and who is named for each part of it?",
    "summary": "A change data capture pipeline as a system model: a source store, a capture connector, a streaming platform, a sink and a backup process, with the ownership actually declared. It is here for two reasons. First, it is the shape most platform teams start with. Second, it reads as a system model, so no analyzer applies to it — the Analyzers page shows all ten greyed with a reason, which is the correct answer and not a bug. One component is deliberately left with no owner. No hostname, cluster name, vendor or topic name appears; every label is generic on purpose.",
    "anonymised": true,
    "createdAt": "2026-07-25T00:00:00.000Z",
    "layers": [
      {
        "id": "l1",
        "name": "Capability and ownership",
        "role": "What the pipeline is for and who is accountable. Nothing deployed belongs here."
      },
      {
        "id": "l2",
        "name": "What runs",
        "role": "Connectors, the streaming platform, the source store and the scheduled jobs. No ownership statements belong here."
      },
      {
        "id": "l3",
        "name": "Where it lands",
        "role": "Downstream stores and the third parties behind them."
      }
    ],
    "nodes": [
      {
        "id": "cap_distribute",
        "layer": "l1",
        "kind": "capability",
        "label": "Near-real-time data distribution",
        "props": {},
        "note": ""
      },
      {
        "id": "ctrl_rpo",
        "layer": "l1",
        "kind": "control",
        "label": "Recovery point objective standard",
        "props": {},
        "note": ""
      },
      {
        "id": "act_platform",
        "layer": "l1",
        "kind": "actor",
        "label": "Platform engineering team",
        "props": {},
        "note": ""
      },
      {
        "id": "act_data",
        "layer": "l1",
        "kind": "actor",
        "label": "Data platform team",
        "props": {},
        "note": ""
      },
      {
        "id": "ds_source",
        "layer": "l2",
        "kind": "datastore",
        "label": "Operational relational cluster",
        "props": {},
        "note": ""
      },
      {
        "id": "app_capture",
        "layer": "l2",
        "kind": "app",
        "label": "Change data capture connector",
        "props": {},
        "note": ""
      },
      {
        "id": "int_bus",
        "layer": "l2",
        "kind": "integration",
        "label": "Event streaming platform",
        "props": {},
        "note": ""
      },
      {
        "id": "app_sink",
        "layer": "l2",
        "kind": "app",
        "label": "Downstream sink connector",
        "props": {},
        "note": "Deliberately left with no OWNED_BY edge. In practice this is the component a vendor wrote and nobody internally adopted."
      },
      {
        "id": "proc_backup",
        "layer": "l2",
        "kind": "process",
        "label": "Scheduled base backup",
        "props": {},
        "note": ""
      },
      {
        "id": "ev_failover",
        "layer": "l2",
        "kind": "event",
        "label": "Source primary failover",
        "props": {},
        "note": ""
      },
      {
        "id": "ds_lake",
