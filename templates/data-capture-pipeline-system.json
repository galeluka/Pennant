      {
        "id": "e_0010",
        "from": "proc_backup",
        "rel": "WRITES_TO",
        "to": "prov_object",
        "note": ""
      },
      {
        "id": "e_0011",
        "from": "ev_failover",
        "rel": "TRIGGERS",
