        "label": "Analytics lake store",
        "props": {},
        "note": ""
      },
      {
        "id": "prov_object",
        "layer": "l3",
        "kind": "provider",
        "label": "Object storage service",
        "props": {},
        "note": ""
      }
    ],
    "edges": [
