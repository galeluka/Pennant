    "logic": {
      "goal": "Name every movement of personal data with no legal basis on record, and every pair of retention rules that cannot both be obeyed.",
      "steps": [
        {
          "id": "st_read",
          "name": "Read the record of processing",
          "kind": "extract",
          "intent": "Lift each data movement and each retention rule out of the source.",
          "prompt": "",
          "consumes": [],
          "produces": [
            "data movements",
            "rule statements"
          ]
        },
        {
          "id": "st_basis",
          "name": "Legal basis check",
          "kind": "analyzer",
          "intent": "Movements absent from the lawful basis register.",
          "prompt": "",
          "consumes": [
            "data movements"
          ],
          "produces": [
            "movements with no basis"
          ],
          "srcNode": "a_basis"
        },
        {
          "id": "st_ret",
          "name": "Retention conflict check",
          "kind": "analyzer",
          "intent": "Rules setting different windows over overlapping rows.",
          "prompt": "",
          "consumes": [
            "rule statements"
          ],
          "produces": [
            "retention conflicts"
          ],
          "srcNode": "a_retention"
        },
        {
          "id": "st_gate",
          "name": "Proportion gate",
          "kind": "proportions",
          "intent": "Is anything held longer than the ceiling the measurements allow?",
          "prompt": "",
          "consumes": [
            "movements with no basis",
            "retention conflicts"
          ],
          "produces": [
            "processing verdict"
          ]
        },
        {
          "id": "st_call",
          "name": "Data protection sign-off",
          "kind": "human",
          "intent": "A named person accepts or refuses, holding the verdict.",
          "prompt": "",
          "consumes": [
            "processing verdict"
          ],
          "produces": []
        }
      ],
