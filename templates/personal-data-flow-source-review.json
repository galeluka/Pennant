  "model": {
    "schemaVersion": 2,
    "id": "m_personal_data_flow",
    "name": "Personal data flow — source review",
    "domain": "personal data processing",
    "domainId": "personal-data-processing",
    "reviewDomain": "source-review",
    "question": "Does every movement of personal data described here have a stated legal basis and a retention period that does not conflict with another?",
    "summary": "A record of processing held as a graph so an export can be checked against the retention rules the organisation already holds. Two retention rules are wired with CONTRADICTS because traffic data is also invoice-supporting data, and the two windows cannot both be obeyed for the same rows. The export interface is checked by an analyzer and has no edge from the lawful-basis register: that absence is the finding, and prose would have hidden it. No real controller, processor, dataset name or jurisdiction appears; retention figures are illustrative and must be replaced.",
    "anonymised": true,
    "createdAt": "2026-07-25T00:00:00.000Z",
    "layers": [
      {
        "id": "l1",
        "name": "Legal basis and retention rules",
        "role": "The rules and the register they derive from, plus who is accountable. No systems belong here."
      },
      {
        "id": "l2",
        "name": "Definitions and measured volumes",
        "role": "Terms defined once, and the measured facts a retention ceiling reads. No rules belong here."
      },
      {
        "id": "l3",
        "name": "Where personal data actually moves",
        "role": "Interfaces, stores and third parties. No governance belongs here."
      }
    ],
    "nodes": [
